<!DOCTYPE html>
<html>
<head>
  <title><%= folder.name %></title>
  <link rel="stylesheet" href="/css/folder.css" />
</head>
<body>
  <%- include('partials/header') %>

  <main class="folderPage">

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } else { %>

      <!-- Header -->
      <div class="folderHeader">
        <h1><%= folder.name %></h1>

        <div class="folderActions">
          <button id="renameBtn">
            <img src="/img/folder-edit.svg" alt="edit">
            <p>Rename</p>
          </button>

          <% if (folder.parentId) { %>
            <button id="deleteBtn" class="dangerBtn">
              <img src="/img/delete-forever.svg" alt="delete">
              <p>Delete</p>
            </button>
          <% } %>
        </div>
      </div>

      <!-- Breadcrumbs -->
       <% if (folder.parentId) { %>
      <nav class="breadcrumbs">
        <% breadcrumbs.forEach((crumb, index) => { %>
          <% if (index !== 0) { %> / <% } %>
          <a href="/folders/<%= crumb.id %>"><%= crumb.name %></a>
        <% }) %>
      </nav>
      <% } %>

      <!-- Content -->
      <section class="contentGrid">

        <% children.forEach(child => { %>
          <a href="/folders/<%= child.id %>" class="item folderItem">
            <img src="/img/folder-open.svg" alt="folder">
            <p class="folderName"><%= child.name %></p>
          </a>
        <% }) %>

        <% files.forEach(file => { %>
          <a href="/files/<%= file.id %>" class="item fileItem">
            <img src="/img/file-document-outline.svg" alt="file">
            <p class="fileName"><%= file.name %></p>
          </a>
        <% }) %>

      </section>

      <!-- New Folder -->
      <div class="newFolderFile">
        <button id="newFolderBtn">
          <img src="/img/folder-plus.svg" alt="">
          <p>New Folder</p>
        </button>
        <button id="uploadFileBtn">
          <img src="/img/file-document-plus-outline.svg" alt="">
          <p>Upload File</p>
        </button>
      </div>

      <!-- Rename Modal -->
      <dialog id="renameDialog">
        <form method="POST" action="/folders/<%= folder.id %>/rename">
          <h2>Rename Folder</h2>
          <input type="text" name="name" value="<%= folder.name %>" required />
          <div class="modalActions">
            <button type="submit">Save</button>
            <button type="button" id="closeRename">Cancel</button>
          </div>
        </form>
      </dialog>

      <!-- Delete Modal -->
      <dialog id="deleteDialog">
        <form method="POST" action="/folders/<%= folder.id %>/delete">
          <h2>Delete Folder</h2>
          <p>This will permanently delete this folder and ALL of its contents.</p>
          <div class="modalActions">
            <button type="submit" class="dangerBtn">Confirm Delete</button>
            <button type="button" id="closeDelete">Cancel</button>
          </div>
        </form>
      </dialog>

      <!-- New Folder Modal -->
      <dialog id="newFolderDialog">
        <form method="POST" action="/folders">
          <input type="hidden" name="parentId" value="<%= folder.id %>" />
          <h2>Create Folder</h2>
          <p>Folder name can only include letters, numbers, hyphens and underscores.</p>
          <input type="text" name="name" required />
          <div class="modalActions">
            <button type="submit">Create</button>
            <button type="button" id="closeNewFolder">Cancel</button>
          </div>
        </form>
      </dialog>

      <!-- Upload File Modal -->
       <dialog id="uploadFileDialog">
          <form action="/folders/<%= folder.id %>/upload" enctype="multipart/form-data" method="POST">
              <input type="hidden" name="parentId" value="<%= folder.id %>" />
              <h2>Upload File</h2>
              <input type="file" class="fileUploadInput" name="file" required/>
              <div class="modalActions">
                <button type="submit">Upload</button>
                <button type="button" id="closeUploadBtn">Cancel</button>
              </div>
          </form>
       </dialog>

    <% } %>

  </main>

  <script>
    const renameBtn = document.getElementById('renameBtn');
    const renameDialog = document.getElementById('renameDialog');
    const closeRename = document.getElementById('closeRename');

    const deleteBtn = document.getElementById('deleteBtn');
    const deleteDialog = document.getElementById('deleteDialog');
    const closeDelete = document.getElementById('closeDelete');

    const newFolderBtn = document.getElementById('newFolderBtn');
    const newFolderDialog = document.getElementById('newFolderDialog');
    const closeNewFolder = document.getElementById('closeNewFolder');

    const uploadFileBtn = document.getElementById('uploadFileBtn');
    const uploadFileDialog = document.getElementById('uploadFileDialog');
    const closeUploadBtn = document.getElementById('closeUploadBtn');

    if (renameBtn) {
      renameBtn.addEventListener('click', () => renameDialog.showModal());
      closeRename.addEventListener('click', () => renameDialog.close());
    }

    if (deleteBtn) {
      deleteBtn.addEventListener('click', () => deleteDialog.showModal());
      closeDelete.addEventListener('click', () => deleteDialog.close());
    }

    if (newFolderBtn) {
      newFolderBtn.addEventListener('click', () => newFolderDialog.showModal());
      closeNewFolder.addEventListener('click', () => newFolderDialog.close());
    }

    if (uploadFileBtn) {
      uploadFileBtn.addEventListener('click', () => uploadFileDialog.showModal());
      closeUploadBtn.addEventListener('click', () => uploadFileDialog.close());
    }
  </script>

</body>
</html>
