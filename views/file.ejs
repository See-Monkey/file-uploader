<!DOCTYPE html>
<html>
	<head>
		<title><%= file.name %></title>
		<link rel="stylesheet" href="/css/file.css" />
	</head>
	<body>
		<%- include('partials/header') %>

		<main class="filePage">
			<!-- Breadcrumbs -->
			<nav class="breadcrumbs">
				<% breadcrumbs.forEach((crumb, index) => { %>
				<% if (index !== 0) { %> / <% } %>
				<a href="/folders/<%= crumb.id %>"><%= crumb.name %></a>
				<% }) %>
			</nav>

			<section class="fileCard">
				<img src="/img/file-document-outline.svg" alt="file" class="fileImg">

				<h1><%= file.name %></h1>

				<ul class="fileDetails">
					<li><strong>Size:</strong> <%= file.size %> bytes</li>
					<li><strong>Type:</strong> <%= file.mimetype %></li>
					<li>
						<strong>Uploaded:</strong> <%= file.createdAt.toDateString() %>
					</li>
				</ul>

				<form action="/files/<%= file.id %>/download" method="GET">
				<button type="submit" id="downloadBtn">
					Download
				</button>
				</form>
			</section>
		</main>
	</body>
</html>
