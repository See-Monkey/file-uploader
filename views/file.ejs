<!DOCTYPE html>
<html>
	<head>
		<title><%= file.name %></title>
		<link rel="stylesheet" href="/css/file.css" />
	</head>
	<body>
		<%- include('partials/header') %>

		<main class="filePage">
			<!-- Breadcrumbs -->
			<nav class="breadcrumbs">
				<% breadcrumbs.forEach((crumb, index) => { %>
				<% if (index !== 0) { %> / <% } %>
				<a href="/folders/<%= crumb.id %>"><%= crumb.name %></a>
				<% }) %>
			</nav>

			<section class="fileCard">
				<img src="/img/file-document-outline.svg" alt="file" class="fileImg">

				<h1><%= file.name %></h1>

				<ul class="fileDetails">
					<li><strong>Size:</strong> <%= file.size %> bytes</li>
					<li><strong>Type:</strong> <%= file.mimetype %></li>
					<li>
						<strong>Uploaded:</strong> <%= file.createdAt.toDateString() %>
					</li>
				</ul>

				<form action="/files/<%= file.id %>/download" method="GET">
				<button type="submit" id="downloadBtn">
					Download
				</button>
				</form>

				<button id="deleteBtn" class="dangerBtn">
					Delete
				</button>

				<button id="shareBtn">Share</button>

				<div id="shareModal" style="display:none;">
					<input type="text" id="shareLinkInput" readonly />
					<button onclick="copyLink()">Copy</button>
				</div>
			</section>

			<!-- Delete Modal -->
			<dialog id="deleteDialog">
			<form method="POST" action="/files/<%= file.id %>/delete">
				<h2>Delete File</h2>
				<p>This will permanently delete this file.</p>
				<div class="modalActions">
					<button type="submit" class="dangerBtn">Confirm Delete</button>
					<button type="button" id="closeDelete">Cancel</button>
				</div>
			</form>
			</dialog>
		</main>

		<script>
			const deleteBtn = document.getElementById('deleteBtn');
			const deleteDialog = document.getElementById('deleteDialog');
			const closeDelete = document.getElementById('closeDelete');

			if (deleteBtn) {
				deleteBtn.addEventListener('click', () => deleteDialog.showModal());
				closeDelete.addEventListener('click', () => deleteDialog.close());
			}

			document.getElementById("shareBtn").addEventListener("click", async () => {
				const fileId = "<%= file.id %>";

				const res = await fetch(`/files/${fileId}/share`, {
				method: "POST"
				});

				const data = await res.json();

				document.getElementById("shareLinkInput").value = data.url;
				document.getElementById("shareModal").style.display = "block";
			});

			function copyLink() {
				const input = document.getElementById("shareLinkInput");
				input.select();
				document.execCommand("copy");
				alert("Copied!");
			}
		</script>
	</body>
</html>
